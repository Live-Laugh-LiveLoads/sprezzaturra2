{
  "type": "object",
  "required": ["idea_id", "title", "summary", "objective", "deliverables", "steps", "tools", "estimated_time", "dependencies", "risks", "definition_of_done"],
  "properties": {
    "idea_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["document", "checklist", "email_draft", "code", "spreadsheet_outline", "research_brief", "presentation_outline"]},
          "description": {"type": "string"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "description"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "estimated_time": {"type": "string"}
        }
      }
    },
    "tools": {"type": "array", "items": {"type": "string"}},
    "estimated_time": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk", "mitigation"],
        "properties": {
          "risk": {"type": "string"},
          "mitigation": {"type": "string"}
        }
      }
    },
    "definition_of_done": {"type": "string", "minLength": 1}
  }
}
